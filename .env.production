RUBBER_HS_CODE=400110

# ===== RATE LIMITING =====
API_RATE_LIMIT=100

# ===== OCR CONFIGURATION =====
TESSDATA_PREFIX=/opt/tessdata
TESSERACT_CMD=/usr/bin/tesseract
