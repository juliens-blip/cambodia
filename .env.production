CLAUDE_MOCK_MODE=true
CLAUDE_MODEL=claude-opus-4-5-20251101

# ===== CHROMADB (VECTOR DATABASE) =====
# Option 1: Cloud ChromaDB (recommandé pour production)
CHROMA_HOST=your-chroma-cloud.trychroma.com
CHROMA_PORT=443
CHROMA_USE_SSL=true

# Option 2: Embedded (pour développement uniquement)
# CHROMA_PERSIST_DIRECTORY=/tmp/chroma_data

# ===== REDIS CACHE (OPTIONNEL) =====
# Utiliser Upstash Redis (gratuit jusqu'à 10K commandes/jour)
REDIS_URL=redis://default:your_password@your-redis.upstash.io:6379

# ===== APPLICATION SETTINGS =====
ENVIRONMENT=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ===== SCHEDULER SETTINGS =====
SCHEDULER_TIMEZONE=Asia/Phnom_Penh
DAILY_COLLECTION_HOUR=6
WEEKLY_ANALYSIS_DAY=monday
WEEKLY_ANALYSIS_HOUR=6

# ===== DATA SOURCE URLs =====
MEF_API_URL=http://www.mef.gov.kh/api
WITS_API_URL=https://wits.worldbank.org/API/V1
ODC_API_URL=https://data.opendevelopmentcambodia.net/api/3

# ===== COMMODITY CODES =====
